# Copy to .env (git-ignored) and fill in. Read by the backend (pydantic-settings)
# and by docker compose (env_file). Docker pins DATA_DIR/DATABASE_URL itself.

# Directory for the SQLite DB and raw JSON caches. Relative paths resolve from backend/.
DATA_DIR=../data

# SQLAlchemy URL. Leave unset to use sqlite:///$DATA_DIR/bedrock.db.
# DATABASE_URL=

# Sent with every SEC EDGAR request (SEC requires a contact), a contact email, e.g. "you@example.com" (sent as "Bedrock <value>").
SEC_USER_AGENT=

# FRED API key: with one, the valuation's risk-free rate default is FRED's DGS10 (else the
# yfinance ^TNX 10-year yield); the M8 macro series use it too.
FRED_API_KEY=

# Line classification (optional, off without a key): a key enables its classifiers for the
# "Classify lines" button. Nothing is sent without a click and a confirmation. Set a spending
# limit in the provider's console as well: the budgets below only limit this app.
# Anthropic API key: enables the Claude Haiku 5.5 and Claude Sonnet 5.5 classifiers.
ANTHROPIC_API_KEY=
# TypeSafe API key: enables the Jev classifier.
TYPESAFE_API_KEY=
# OpenRouter API key: enables the classifiers reached through openrouter.ai (GPT-6 Luna, paid;
# Nemotron 3.5 Super, free: 50 requests a day under $10 of credits bought).
OPENROUTER_API_KEY=
# Input + output tokens all classification runs may use per UTC day and per UTC calendar month.
CLASSIFY_DAILY_TOKENS=300000
CLASSIFY_MONTHLY_TOKENS=3000000
# Lines one run asks at most.
CLASSIFY_MAX_LINES_PER_RUN=300
# Confidence a proposal needs to be used unreviewed under the mode "All above".
CLASSIFY_MIN_CONFIDENCE=0.9

# true: refresh every company's prices hourly in US market hours (and once after the close),
# and the market series behind the valuation defaults once a day. EDGAR stays manual.
SCHEDULED_REFRESH=true

# Argon2 hash of the login password: `cd backend && uv run bedrock hash-password`.
# Empty means every login fails. In .env, wrap the value in single quotes (it contains `$`).
APP_PASSWORD_HASH=

# Required: secret that signs the session cookie (the app refuses to start if it is unset or blank). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Minutes of inactivity before a session expires.
SESSION_IDLE_MINUTES=720

# true when served over HTTPS (e.g. tailscale serve): marks the session cookie Secure.
COOKIE_SECURE=false

# Built SPA directory served by the backend with an index.html fallback. Unset in dev
# (Vite serves the SPA); the prod image sets it to /app/static.
# STATIC_DIR=../frontend/dist
