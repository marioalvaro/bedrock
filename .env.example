# Copy to .env (git-ignored) and fill in. Read by the backend (pydantic-settings)
# and by docker compose (env_file). Docker pins DATA_DIR/DATABASE_URL itself.

# Directory for the SQLite DB and raw JSON caches. Relative paths resolve from backend/.
DATA_DIR=../data

# SQLAlchemy URL. Leave unset to use sqlite:///$DATA_DIR/bedrock.db.
# DATABASE_URL=

# Sent with every SEC EDGAR request (SEC requires a contact), a contact email, e.g. "you@example.com" (sent as "Bedrock <value>").
SEC_USER_AGENT=

# FRED API key for macro series (used from M8).
FRED_API_KEY=

# Argon2 hash of the login password: `cd backend && uv run bedrock hash-password`.
# Empty means every login fails. In .env, wrap the value in single quotes (it contains `$`).
APP_PASSWORD_HASH=

# Required: secret that signs the session cookie (the app refuses to start if it is unset or blank). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Minutes of inactivity before a session expires.
SESSION_IDLE_MINUTES=720

# true when served over HTTPS (e.g. tailscale serve): marks the session cookie Secure.
COOKIE_SECURE=false

# Built SPA directory served by the backend with an index.html fallback. Unset in dev
# (Vite serves the SPA); the prod image sets it to /app/static.
# STATIC_DIR=../frontend/dist
